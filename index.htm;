<style>
:root{
  --ink:#0f2a2e; --muted:#4d6468; --bg:#f5f8f7; --card:#ffffff;
  --line:#d5e2e0; --teal:#0e8c7f; --teal-dark:#0a6b61; --amber:#e8a33d;
  color-scheme:light;
}
@media (prefers-color-scheme:dark){
  :root{--ink:#e8f1f0; --muted:#9db3b6; --bg:#0c1a1d; --card:#12262a; --line:#24403f; --teal:#2fc0b0; --teal-dark:#5fd6c8; color-scheme:dark;}
}
*{box-sizing:border-box;margin:0}
html{scroll-behavior:smooth}
body{font-family:"IBM Plex Sans Arabic",Tahoma,Arial,sans-serif;background:var(--bg);color:var(--ink);line-height:1.8;font-size:17px}
a{color:inherit}
:focus-visible{outline:3px solid var(--amber);outline-offset:3px;border-radius:4px}
.wrap{max-width:1040px;margin:0 auto;padding:0 20px}

/* header */
header{border-bottom:1px solid var(--line)}
nav{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:16px 0;flex-wrap:wrap}
.who{display:flex;align-items:center;gap:12px;text-decoration:none}
.avatar{width:44px;height:44px;border-radius:50%;background:var(--teal);color:#fff;display:grid;place-items:center;font-weight:700;font-size:15px}
.who b{display:block;line-height:1.3}
.who small{color:var(--muted);font-size:14px}
nav ul{list-style:none;display:flex;gap:22px;padding:0;flex-wrap:wrap}
nav ul a{text-decoration:none;color:var(--muted);font-weight:500}
nav ul a:hover{color:var(--teal)}

/* hero */
.hero{padding:72px 0 56px}
.hero h1{font-size:clamp(30px,5.2vw,52px);line-height:1.35;font-weight:700;max-width:18ch}
.hero p{margin-top:18px;color:var(--muted);max-width:56ch;font-size:19px}
.cta{display:flex;gap:12px;margin-top:28px;flex-wrap:wrap}
.btn{display:inline-block;padding:12px 24px;border-radius:10px;font-weight:700;text-decoration:none;border:2px solid var(--teal);transition:background .15s}
.btn.primary{background:var(--teal);color:#fff}
.btn.primary:hover{background:var(--teal-dark);border-color:var(--teal-dark)}
.btn.ghost{color:var(--teal)}
.btn.ghost:hover{background:var(--card)}

/* order lifecycle strip: the one memorable element */
.flow{margin-top:48px;padding:22px;border:1px solid var(--line);border-radius:14px;background:var(--card)}
.flow h2{font-size:15px;color:var(--muted);font-weight:500;margin-bottom:16px}
.flow ol{list-style:none;padding:0;display:grid;grid-template-columns:repeat(4,1fr);gap:0}
.flow li{position:relative;padding-top:30px;font-weight:700;font-size:16px;opacity:.35;animation:lit .5s ease forwards}
.flow li::before{content:"";position:absolute;top:6px;right:0;width:14px;height:14px;border-radius:50%;background:var(--teal)}
.flow li::after{content:"";position:absolute;top:12px;right:14px;left:0;height:2px;background:var(--line)}
.flow li:last-child::after{display:none}
.flow li:nth-child(1){animation-delay:.3s}
.flow li:nth-child(2){animation-delay:1s}
.flow li:nth-child(3){animation-delay:1.7s}
.flow li:nth-child(4){animation-delay:2.4s}
.flow li span{display:block;font-weight:400;font-size:14px;color:var(--muted)}
@keyframes lit{to{opacity:1}}

/* sections */
section{padding:48px 0}
section>.wrap>h2{font-size:28px;margin-bottom:8px}
.lead{color:var(--muted);margin-bottom:28px;max-width:60ch}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:20px}
.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:24px;display:flex;flex-direction:column;gap:12px}
.card h3{font-size:20px;line-height:1.5}
.card p{color:var(--muted)}
.tech{font-size:14px;color:var(--muted);border-top:1px solid var(--line);padding-top:12px;margin-top:auto}
.links{display:flex;gap:10px;flex-wrap:wrap}
.links a{padding:8px 16px;border-radius:8px;border:1px solid var(--line);text-decoration:none;font-size:15px;font-weight:500}
.links a.main{background:var(--teal);border-color:var(--teal);color:#fff}
.links a:hover{border-color:var(--teal)}
.video{position:relative;aspect-ratio:16/9;border-radius:10px;overflow:hidden;background:var(--line)}
.video iframe{position:absolute;inset:0;width:100%;height:100%;border:0}

/* services */
.services{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:20px}
.services div{border-top:3px solid var(--teal);padding-top:14px}
.services h3{font-size:18px;margin-bottom:4px}
.services p{color:var(--muted);font-size:16px}

/* contact */
.contact{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:36px;text-align:center}
.contact h2{margin-bottom:8px}
.contact p{color:var(--muted);margin-bottom:22px}
.contact .cta{justify-content:center;margin-top:0}

footer{padding:32px 0;color:var(--muted);font-size:15px;text-align:center}

@media (max-width:640px){
  .hero{padding:44px 0 36px}
  .flow ol{grid-template-columns:1fr 1fr;row-gap:20px}
  .flow li:nth-child(2)::after{display:none}
  .contact{padding:28px 18px}
}
@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  .flow li{animation:none;opacity:1}
}
</style>
</head>
